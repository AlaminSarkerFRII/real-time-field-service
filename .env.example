# Copy to .env and fill in real values. .env is never committed.

# Django
SECRET_KEY=changeme-generate-a-real-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database — matches deploy/docker-compose.yml's db service
DATABASE_URL=postgres://fieldsync:fieldsync@db:5432/fieldsync

# Redis — channel layer + Celery broker, wired in a later step
REDIS_URL=redis://redis:6379/0

# Platform superuser — created idempotently by `manage.py bootstrap_superuser`.
# Never a real credential in this file; set a real one in your own .env.
DJANGO_SUPERUSER_EMAIL=admin@fieldsync.local
DJANGO_SUPERUSER_PASSWORD=changeme
DJANGO_SUPERUSER_FULL_NAME=Platform Admin
